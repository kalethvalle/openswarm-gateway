GROQ_API_KEY=
# Optional, used only when config.yaml selects provider: openrouter
OPENROUTER_API_KEY=
GATEWAY_API_KEY=replace-with-a-long-random-key
CONFIG_PATH=config.yaml
DATABASE_PATH=data/openswarm-groq.sqlite
# Optional Docker override; keep a separate database when switching providers.
CONTAINER_DATABASE_PATH=/app/data/openswarm-groq.sqlite
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Optional local Laya service settings. Docker overrides LAYA_BASE_URL internally.
# LAYA_BASE_URL=http://127.0.0.1:8001
# LAYA_API_KEY=
# LAYA_DEVICE=cpu
# LAYA_THREADS=2
